# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_NAME=openai/gpt-oss-20b
GUARDIAN_AGENT_ENABLED=true

# Optional providers
OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GOOGLE_API_KEY=your_google_api_key

# ---- Database ----
DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require&channel_binding=require
DATABASE_SCHEMA=antiscam

# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_ENVIRONMENT=your_pinecone_environment

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith ----
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=your_langchain_project
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Risk Telemetry ----
RISK_TELEMETRY_HASH_KEY=your_risk_telemetry_hash_key

# ---- Google OAuth ----
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ---- Chat Agent ----
CHAT_AGENT_API_KEY=your_chat_agent_api_key
CHAT_AGENT_API_KEYS=your_chat_agent_api_key  # Keys from the same account may share the same quota/rate limits.
CHAT_AGENT_BASE_URL=https://api.groq.com/openai/v1
CHAT_AGENT_MODEL=openai/gpt-oss-20b

# ---- Guardian Agent ----
GUARDIAN_AGENT_API_KEY=your_guardian_agent_api_key
GUARDIAN_AGENT_API_KEYS=your_guardian_agent_api_key # Keys from the same account may share the same quota/rate limits.
GUARDIAN_AGENT_BASE_URL=https://api.groq.com/openai/v1
GUARDIAN_AGENT_MODEL=openai/gpt-oss-20b

# ---- Guardian STT ----
GUARDIAN_STT_API_KEY=your_guardian_stt_api_key
GUARDIAN_STT_API_KEYS=your_guardian_stt_api_key # Keys from the same account may share the same quota/rate limits.
GUARDIAN_STT_BASE_URL=https://api.groq.com/openai/v1
GUARDIAN_STT_MODEL=whisper-large-v3

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- Email / Gmail SMTP ----
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=Timi <your_email@gmail.com>

# Production example:
# EMAIL_FROM=Timi <noreply@yourdomain.com>

# ---- AI Hook Logging ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your_ai_log_api_key
AI_LOG_DIR=.ai-log
